{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "oh-my-opencode-slim"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },
  "lsp": {
    "ts_ls": {
      "disabled": true
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ]
    },
    "vtsls": {
      "command": [
        "lspmux",
        "client",
        "--server-path",
        "vtsls",
        "--",
        "--stdio"
      ],
      "extensions": [
        ".ts"
      ]
    },
    "eslint": {
      "command": [
        "lspmux",
        "client",
        "--server-path",
        "vscode-eslint-language-server",
        "--",
        "--stdio"
      ],
      "extensions": [
        ".ts"
      ]
    }
  },
  "permission": {
    "edit": "ask",
    "read": "allow",
    "bash": {
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny"
    },
    "grep *": "allow"
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "foo": {
      "model": "local/gemma-4-12b-it",
      "prompt": "You are Gemma 4 12B!"
    }
  },
  "provider": {
    "opencode-go": {
      "models": {
        "qwen3.6-plus": {
          "limit": {
            "context": 200000,
            "input": 150000,
            "output": 120000
          }
        },
        "deepseek-v4-flash": {
          "limit": {
            "context": 200000,
            "input": 150000,
            "output": 100000
          }
        },
        "opencode-go/kimi-k2.6": {
          "limit": {
            "context": 100000,
            "output": 64000
          }
        }
      }
    },
    "local": {
      "name": "Locale GPU",
      "api": "openai",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "gemma-4-12b-it": {
          "name": "Gemma 4 12B",
          "limit": {
            "context": 4096,
            "output": 2048
          }
        }
      }
    }
  }
}
