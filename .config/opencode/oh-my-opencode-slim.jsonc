			},
			"council": {
				"model": "openrouter/moonshotai/kimi-k2.5",
				"variant": "high",
			},
		},
		// ──────────────────────────────────────────────
		// Preset: copilot
		// Uses GitHub Copilot provider for all agents
		// ──────────────────────────────────────────────
		"copilot": {
			"orchestrator": {
				"model": "github-copilot/gemini-3.1-pro-preview",
				"skills": [
					"*"
				],
				"mcps": [
					"*",
					"!context7"
				],
			},
			"oracle": {
				"model": "github-copilot/gpt-5.2",
				"variant": "high",
