{
	"$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
	"preset": "opencode-go",
	"multiplexer": {
		"type": "auto",
		"layout": "main-vertical",
		"main_pane_size": 50
	},
	"showStartupToast": true,
	"autoUpdate": true,
	"fallback": {
		"enabled": false
	},
	// "todoContinuation": {
	// 	"autoEnable": true,
	// 	"autoEnableThreshold": 4
	// },
	"council": {
		"presets": {
			"default": {
				"alpha": {
					"model": "opencode-go/mimo-v2.5-flash"
				},
				"beta": {
					"model": "opencode-go/deepseek-v4-pro"
				},
				"gamma": {
					"model": "opencode-go/qwen3.6-plus"
				}
			}
		}
	},
	"presets": {
		"opencode-go": {
			"orchestrator": {
				"model": "opencode-go/deepseek-v4-pro",
				"temperature": 0.2,
				"skills": [
					"*"
				],
				"mcps": [
					"*",
					"!context7"
				]
			},
			"oracle": {
				"model": "opencode-go/kimi-k2.6",
				"variant": "high",
				"skills": [
					"simplify"
				],
				"mcps": []
			},
			"librarian": {
				"model": "opencode-go/deepseek-v4-flash",
				"variant": "low",
				"skills": [],
				"mcps": [
					"websearch",
					"context7",
					"grep_app"
				]
			},
			"explorer": {
				"model": "opencode-go/deepseek-v4-flash",
				"variant": "low",
				"skills": [],
				"mcps": []
			},
			"designer": {
				"model": "opencode-go/glm-5.1",
				"variant": "medium",
				"skills": [],
				"mcps": [],
			},
			"fixer": {
          "model": "opencode-go/mimo-v2.5",
				"variant": "low",
				"skills": [],
				"mcps": [],
			},
			"council": {
				"model": "opencode-go/mimo-v2.5-pro",
			},
		},
		"openrouter": {
			"orchestrator": {
				"model": "openrouter/moonshotai/kimi-k2.5",
				"skills": [
					"*"
				],
				"mcps": [
					"*",
					"!context7"
				],
			},
			"oracle": {
				"model": "openrouter/z-ai/glm-5",
				"variant": "high",
				"skills": [
					"simplify"
				],
			},
			"librarian": {
				"model": "openrouter/z-ai/glm-4.7-flash",
				"variant": "low",
				"skills": [],
				"mcps": [
					"websearch",
					"context7",
					"grep_app"
				],
			},
			"explorer": {
				"model": "openrouter/minimax/minimax-m2.5",
				"variant": "low",
