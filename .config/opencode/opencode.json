{
	"$schema": "https://opencode.ai/config.json",
	"plugin": [
		"oh-my-opencode-slim",
		"@mohak34/opencode-notifier@latest"
	],
	"lsp": {
		"ts_ls": {
			"disabled": true
		},
		"typescript": {
			"disabled": true
		},
		"vtsls": {
			"command": [
				"lspmux",
				"client",
				"--server-path",
				"vtsls",
				"--",
				"--stdio"
			],
			"extensions": [
				".ts"
			]
		},
		"eslint": {
			"command": [
				"lspmux",
				"client",
				"--server-path",
				"vscode-eslint-language-server",
				"--",
				"--stdio"
			],
			"extensions": [
				".ts"
			]
		}
	},
	"permission": {
		"edit": "ask",
		"read": "allow",
		"bash": {
			"git *": "allow",
			"git commit *": "deny",
			"git push *": "deny"
		},
		"grep *": "allow"
	},
	"agent": {
		"plan": {
			"disable": true
		},
		"build": {
			"disable": true
		},
		"general": {
			"disable": true
		},
		"explore": {
			"disable": true
		}
	},
	"provider": {
		"opencode-go": {
			"models": {
				"qwen3.6-plus": {
					"limit": {
						"context": 200000,
						"input": 150000,
						"output": 120000
					}
				},
				"deepseek-v4-flash": {
					"limit": {
						"context": 200000,
						"input": 150000,
						"output": 100000
					}
				}
			}
		}
	}
}
