{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "plugin": ["@mohak34/opencode-notifier@latest", "oh-my-opencode-slim"],
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 8192
  },
  "permission": {
    "edit": "ask",
    "read": "allow",
    "bash": {
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "deny"
    },
    "grep *": "allow",
    "external_directory": {
      "~/git/**": "allow",
      "~/.config/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "limit": {
            "context": 300000,
            "input": 200000,
            "output": 100000
          }
        },
        "opencode-go/kimi-k2.6": {
          "limit": {
            "context": 100000,
            "input": 80000,
            "output": 32000
          }
        }
      }
    }
  },
  "lsp": true
}
